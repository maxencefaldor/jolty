dist/
*.so
*.pyd

# What building and simulating the examples writes
examples/*.jolty.json
examples/*.results.npz
examples/*.png
site/

# What simulating the discoveries' designs writes
discovery/*/*.jolty.json
discovery/*/*.results.npz
discovery/*/*.png

# The 3D viewers the commands write; the gallery's are pages of the docs
examples/*.view.html

# The robustness corpus's results: their messages quote lines of third-party decks,
# GPL among them, which the repository never holds
benchmarks/robustness/results/
# The precision suite's results, diagrams and table, which `scripts/bench --precision`
# writes again: comparisons with other simulators stay out of the repository
benchmarks/precision/results/
