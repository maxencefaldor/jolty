#!/usr/bin/env bash
# Copyright 2026 Maxence Faldor
#
# Every check a change must pass, exactly as CI runs them.
#
#   scripts/check            every group, as the pre-push hook runs it
#   scripts/check rust       Rust format, lints and tests
#   scripts/check python     Python format, lints, types, Markdown, tests and examples
#   scripts/check docs       the generated reference pages and the documentation site
#
# CI runs each group in a job of its own, the Rust and Python groups on Linux and on
# macOS, after installing what the group needs, so a change that passes here passes
# there. The Python group's differential tests run when ngspice is installed; without
# it they skip, or fail where JOLTY_REQUIRE_NGSPICE=1, as CI sets.

set -euo pipefail
cd "$(dirname "$0")/.."

check_rust() {
    PYO3_PYTHON="${PYO3_PYTHON:-$(uv python find)}"
    export PYO3_PYTHON
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings
    cargo test --workspace --locked
}

check_python() {
    uv sync --locked
    uv run --locked ruff format --check
    uv run --locked ruff check
    uv run --locked ty check
    uv run --locked rumdl check .
    uv run --locked pytest
    # Every example script, each defining build(); the modules they share define none.
    for example in $(grep -l '^def build' examples/*.py); do
        uv run --locked jolty simulate "$example" > /dev/null
    done
}

check_docs() {
    uv sync --locked --group docs
    uv run --locked python docs/reference.py > /dev/null
    git diff --exit-code docs/reference/
    uv run --locked zensical build --clean
}

case "${1:-all}" in
    rust | python | docs) "check_$1" ;;
    all)
        # One after another, never joined by `&&`: bash ignores `set -e` inside a
        # function called on the left of `&&`, so a failing check would pass unseen.
        check_rust
        check_python
        check_docs
        ;;
    *)
        echo "usage: scripts/check [rust | python | docs]" >&2
        exit 2
        ;;
esac
