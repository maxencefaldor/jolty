#!/usr/bin/env bash
# Copyright 2026 Maxence Faldor
#
# Every check a change must pass, exactly as CI runs them.
#
#   scripts/check            every group, as the pre-push hook runs it
#   scripts/check rust       Rust format, lints, advisories and tests
#   scripts/check python     Python advisories, format, lints, types, Markdown, tests and
#                            examples
#   scripts/check free-threaded   the Python tests on free-threaded Python, without the GIL
#   scripts/check docs       the generated reference pages and the documentation site
#
# CI runs each group in a job of its own, the Rust and Python groups on Linux and on
# macOS, after installing what the group needs, so a change that passes here passes
# there. The Python group's differential tests run when ngspice is installed; without
# it they skip, or fail where JOLTY_REQUIRE_NGSPICE=1, as CI sets. The advisories are
# fetched from the network.

set -euo pipefail
cd "$(dirname "$0")/.."

check_rust() {
    PYO3_PYTHON="${PYO3_PYTHON:-$(uv python find)}"
    export PYO3_PYTHON
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings
    RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked
    # The crates of Cargo.lock against RustSec's advisories, fetched afresh: a known
    # vulnerability fails; an unmaintained, unsound or yanked crate is printed.
    cargo audit
    # Each test in a process of its own, every crate's at once; nextest runs no doctests,
    # which cargo's own runner does.
    cargo nextest run --workspace --locked
    cargo test --workspace --doc --locked
}

check_python() {
    uv sync --locked
    # Every package of uv.lock, of every group, against OSV's advisories and PyPI's
    # project statuses, such as a quarantine: a known vulnerability fails. The command
    # is in preview, which the flag acknowledges.
    uv audit --locked --preview-features audit-command
    uv run --locked ruff format --check
    uv run --locked ruff check
    uv run --locked ty check
    uv run --locked rumdl check .
    uv run --locked pytest
    uv run --locked python benchmarks/deterministic.py
    # Every example script, each defining build(); the modules they share define none.
    # They run at once, one per processor, and xargs fails when any of them fails.
    # Use --no-sync after the upfront `uv sync --locked` so concurrent workers do not
    # contend on the environment lock. Sharded cluster examples declare millions of
    # Monte Carlo samples for multi-node runs, so run a 2-sample shard in a temp dir.
    grep -rl --include='*.py' '^def build' examples/ |
        grep -v '^examples/cluster/' |
        sort |
        xargs -n 1 -P "$(getconf _NPROCESSORS_ONLN)" uv run --no-sync jolty simulate > /dev/null
    (
        shard_tmp="$(mktemp -d)"
        trap 'rm -rf "$shard_tmp"' EXIT
        for sharded in examples/cluster/*.py; do
            if grep -q '^def build' "$sharded"; then
                uv run --no-sync jolty simulate "$sharded" \
                    --samples 0:2 \
                    --output "$shard_tmp/$(basename "$sharded" .py).jolty.json" \
                    --shards "$shard_tmp/shards" > /dev/null
            fi
        done
    )
}

# In an environment of its own, so the project's stays as it was. The extension declares
# it needs no GIL; were it to turn the GIL back on as it loads, Python would warn, which
# the tests make an error.
check_free_threaded() (
    export UV_PYTHON=3.15t UV_PROJECT_ENVIRONMENT=.venv-free-threaded
    uv sync --locked
    uv run --locked python -c "import sys, jolty._core; assert not sys._is_gil_enabled()"
    uv run --locked pytest
)
check_docs() {
    uv sync --locked --group docs
    uv run --locked python docs/reference.py > /dev/null
    git diff --exit-code docs/reference/
    if [ -n "$(git status --porcelain -- docs/reference/)" ]; then
        git status --short -- docs/reference/ >&2
        return 1
    fi
    uv run --locked zensical build --clean
}

case "${1:-all}" in
    rust | python | docs) "check_$1" ;;
    free-threaded) check_free_threaded ;;
    all)
        # One after another, never joined by `&&`: bash ignores `set -e` inside a
        # function called on the left of `&&`, so a failing check would pass unseen.
        check_rust
        check_python
        check_free_threaded
        check_docs
        ;;
    *)
        echo "usage: scripts/check [rust | python | free-threaded | docs]" >&2
        exit 2
        ;;
esac
