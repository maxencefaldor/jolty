#!/usr/bin/env bash
# Copyright 2026 Maxence Faldor
#
# Every check a change must pass, exactly as CI runs them.
#
#   scripts/check            every group, as the pre-push hook runs it
#   scripts/check rust       Rust format, lints, advisories and tests
#   scripts/check python     Python advisories, format, lints, types, Markdown, tests and
#                            examples
#   scripts/check free-threaded   the Python tests on free-threaded Python, without the GIL
#   scripts/check docs       the generated reference pages and the documentation site
#
# CI runs each group in a separate job (Rust and Python on Linux and macOS; docs on
# Linux) after installing group prerequisites, so local runs match CI directly.
# Differential Python tests run when ngspice is installed, skip otherwise, and fail
# when JOLTY_REQUIRE_NGSPICE=1 is set (as in CI).
# Advisory databases are fetched over the network.

set -euo pipefail
cd "$(dirname "$0")/.."

check_rust() {
    PYO3_PYTHON="${PYO3_PYTHON:-$(uv python find)}"
    export PYO3_PYTHON
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings
    RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked
    # Audit Cargo.lock crates against fresh RustSec advisories: known vulnerabilities
    # fail, while unmaintained, unsound, or yanked crates are printed.
    cargo audit
    # Run unit and integration tests across all crates in separate processes via
    # nextest, then run doctests via cargo test.
    cargo nextest run --workspace --locked
    cargo test --workspace --doc --locked
}

check_python() {
    uv sync --locked
    # Audit all uv.lock packages across every dependency group against OSV advisories
    # and PyPI statuses; known vulnerabilities fail. The flag opts into the preview
    # audit command.
    uv audit --locked --preview-features audit-command
    uv run --locked ruff format --check
    uv run --locked ruff check
    uv run --locked ty check
    uv run --locked rumdl check .
    uv run --locked pytest
    uv run --locked python benchmarks/deterministic/bench.py
    # Execute every standalone example script defining build() in parallel, skipping
    # shared helper modules and cluster scripts. Pass --no-sync after upfront
    # `uv sync --locked` so concurrent workers avoid contending on the environment
    # lock. Sharded cluster examples declare millions of Monte Carlo samples, so run
    # a 2-sample shard in a temporary directory instead.
    grep -rl --include='*.py' '^def build' examples/ |
        grep -v '^examples/cluster/' |
        sort |
        xargs -n 1 -P "$(getconf _NPROCESSORS_ONLN)" uv run --no-sync jolty simulate > /dev/null
    (
        shard_tmp="$(mktemp -d)"
        trap 'rm -rf "$shard_tmp"' EXIT
        for sharded in examples/cluster/*.py; do
            if grep -q '^def build' "$sharded"; then
                uv run --no-sync jolty simulate "$sharded" \
                    --samples 0:2 \
                    --output "$shard_tmp/$(basename "$sharded" .py).jolty.json" \
                    --shards "$shard_tmp/shards" > /dev/null
            fi
        done
    )
}

# Run Python tests in a separate free-threaded environment to leave the main
# environment untouched. The extension declares free-threaded support; re-enabling
# the GIL during import triggers a warning that pytest treats as an error.
check_free_threaded() (
    export UV_PYTHON=3.15t UV_PROJECT_ENVIRONMENT=.venv-free-threaded
    uv sync --locked
    uv run --locked python -c "import sys, jolty._core; assert not sys._is_gil_enabled()"
    uv run --locked pytest
)
check_docs() {
    uv sync --locked --group docs
    uv run --locked python docs/reference.py > /dev/null
    git diff --exit-code docs/reference/
    if [ -n "$(git status --porcelain -- docs/reference/)" ]; then
        git status --short -- docs/reference/ >&2
        return 1
    fi
    uv run --locked zensical build --clean
}

case "${1:-all}" in
    rust | python | docs) "check_$1" ;;
    free-threaded) check_free_threaded ;;
    all)
        # Run groups sequentially rather than with `&&` because bash ignores `set -e`
        # inside functions called on the left of `&&`.
        check_rust
        check_python
        check_free_threaded
        check_docs
        ;;
    *)
        echo "usage: scripts/check [rust | python | free-threaded | docs]" >&2
        exit 2
        ;;
esac
