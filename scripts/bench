#!/usr/bin/env bash
# Copyright 2026 Maxence Faldor
#
# The benchmarks of benchmarks/, every suite's one command line. By default the speed
# suite: the criterion benchmarks of the engine and a Python timing of the same
# fixtures, written to benchmarks/speed/results/<commit>.json and compared with a
# baseline's, each median with its 95 % interval, a change named only where the
# intervals separate. They stay out of scripts/check, which must stay fast and
# deterministic.
#
#   scripts/bench                     the speed suite, a few minutes, before and after a change
#                                     (with isolated peak resident memory per fixture)
#   scripts/bench --compare A,B       the builds of revisions A and B, their runs alternating
#   scripts/bench --nightly DIR       the checked-out commit against the previous night's
#   scripts/bench --scale             the large fixtures, serially and spread, in rounds,
#                                     plus N concurrent 1-thread copies for throughput efficiency
#   scripts/bench --scale --largest   and the 50,000 inverters' chain spread too
#   scripts/bench --no-peak-memory    skip isolated peak resident memory probes
#   scripts/bench --no-concurrent-copies  with --scale, skip concurrent single-thread copies
#   scripts/bench --copy-rounds N     rounds of concurrent copies under --scale (default 3)
#   scripts/bench --view matched      every simulator on the fixtures, at matched options
#   scripts/bench --view defaults     every simulator on them, each at its own defaults
#   scripts/bench --view equal-error  every simulator's least time to equal error, on the
#                                     precision suite's fixtures
#   scripts/bench --baseline COMMIT   against COMMIT's results rather than an ancestor's
#   scripts/bench --break-even NAME   from which size the threshold NAME pays
#   scripts/bench --robustness        the hard circuits' corpus, in every simulator
#   scripts/bench --coverage          the coverage matrix, each row's fixture in each simulator
#   scripts/bench --precision         each simulator's error against exact answers, and its cost
#
# benchmarks/speed/README.md documents what each fixture stresses and holds the baseline;
# benchmarks/precision/README.md documents what each fixture measures and reports findings;
# benchmarks/robustness/README.md documents the corpus contents and evaluation criteria;
# benchmarks/coverage/README.md specifies how coverage matrix fixtures are built and scored.

set -euo pipefail
cd "$(dirname "$0")/.."

uv sync --locked
exec uv run --locked python benchmarks/speed/bench.py "$@"
