#!/usr/bin/env bash
# Copyright 2026 Maxence Faldor
#
# The benchmarks of benchmarks/, every suite's one command line. By default the speed
# suite: the criterion benchmarks of the engine and a Python timing of the same
# fixtures, written to benchmarks/speed/results/<commit>.json and compared with a
# baseline's, every change over 5 % flagged. They stay out of scripts/check, which must
# stay fast and deterministic.
#
#   scripts/bench                     the speed suite, a few minutes, before and after a change
#   scripts/bench --scale             the large fixtures, each run once, and spread
#   scripts/bench --scale --largest   and the 50,000 inverters' chain spread too
#   scripts/bench --view matched      every simulator on the fixtures, at matched options
#   scripts/bench --view defaults     every simulator on them, each at its own defaults
#   scripts/bench --view equal-error  every simulator's least time to equal error, on the
#                                     precision suite's fixtures
#   scripts/bench --baseline COMMIT   against COMMIT's results rather than an ancestor's
#   scripts/bench --break-even NAME   from which size the threshold NAME pays
#   scripts/bench --robustness        the hard circuits' corpus, in every simulator
#   scripts/bench --coverage          the coverage matrix, each row's fixture in each simulator
#   scripts/bench --precision         each simulator's error against exact answers, and its cost
#
# benchmarks/speed/README.md says what each fixture stresses, and holds the baseline;
# benchmarks/precision/README.md says what each fixture measures, and what it found;
# benchmarks/robustness/README.md says what the corpus holds and how it judges;
# benchmarks/coverage/README.md says how the coverage matrix's fixtures are made and judged.

set -euo pipefail
cd "$(dirname "$0")/.."

uv sync --locked
exec uv run --locked python benchmarks/speed/bench.py "$@"
