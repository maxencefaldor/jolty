#!/usr/bin/env bash
# Copyright 2026 Maxence Faldor
#
# The precision suite: each simulator's error against exact answers, against its cost,
# from perf/precision/, written to perf/results/precision/<commit>.json with a
# work-precision diagram per fixture. It stays out of scripts/check, as the benchmarks
# do: it times its runs.
#
#   scripts/precision                      every fixture, in jolty and ngspice
#   scripts/precision rc_step lc_tank      only these fixtures
#   scripts/precision --simulators jolty   one simulator configuration
#   scripts/precision --plot RESULTS       the diagrams and table of a results file
#
# perf/precision/README.md says what each fixture measures, and what it found.

set -euo pipefail
cd "$(dirname "$0")/.."

uv sync --locked
exec uv run --locked python perf/precision/suite.py "$@"
